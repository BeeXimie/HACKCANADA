{
  "manifest_version": 3,
  "name": "ScholarSync Autofill",
  "version": "1.0",
  "description": "Autofill scholarship applications with Gemini AI",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ]
}
